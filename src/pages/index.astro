---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import productos from "../data/productos.json";

// CONFIGURA AQUÍ TU NÚMERO DE WHATSAPP (sin +)
const TELEFONO_WHATSAPP = "56912345678";
---

<BaseLayout title="Catálogo de Productos">
  <Header logoSrc="/logo.svg" title="Catálogo" />

  <main class="container">
    <section class="gallery">
      {productos.map((p) => (
        <ProductCard
          producto={p}
          telefonoPaisNumero={TELEFONO_WHATSAPP}
        />
      ))}
    </section>
  </main>

  <Footer whatsapp={TELEFONO_WHATSAPP} email="" />
</BaseLayout>