---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import productos from "../data/productos.json";

// CONFIGURA AQUÍ TUS DATOS
const TELEFONO_WHATSAPP = "56912345678";
const INSTAGRAM = "tu_usuario_instagram";

// Filtrar productos de categoría amigurumi
const amigurumis = productos.filter((p) => p.categoria === "amigurumi");
---

<BaseLayout title="Amigurumis - Isilanitass">
  <Header
    logoSrc="/logo.svg"
    title="Isilanitass"
    whatsapp={TELEFONO_WHATSAPP}
    instagram={INSTAGRAM}
  />

  <main class="container pagina-catalogo">
    <h1 class="pagina-titulo">Amigurumis</h1>
    <p class="pagina-subtitulo">
      Muñecos tejidos a mano, perfectos para regalar o coleccionar.
    </p>

    {amigurumis.length > 0 ? (
      <section class="gallery">
        {amigurumis.map((p) => (
          <ProductCard
            producto={p}
            telefonoPaisNumero={TELEFONO_WHATSAPP}
          />
        ))}
      </section>
    ) : (
      <p style="color: var(--text-muted)">
        Pronto más amigurumis. Escríbeme si buscas algo en especial.
      </p>
    )}
  </main>

  <Footer whatsapp={TELEFONO_WHATSAPP} instagram={INSTAGRAM} />
</BaseLayout>

<style>
  .pagina-catalogo {
    padding: 2.5rem 1rem 3.5rem;
    max-width: 1100px;
  }

  .pagina-titulo {
    margin-bottom: 0.5rem;
    font-size: 2rem;
    background: linear-gradient(90deg, var(--gold-light), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pagina-subtitulo {
    color: var(--text-muted);
    margin-bottom: 1.8rem;
    font-size: 1rem;
  }
</style>