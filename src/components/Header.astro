---
import Menu from "./Menu.astro";

const {
  logoSrc,
  whatsapp = "",
  instagram = "",
} = Astro.props;

const base = import.meta.env.BASE_URL;

const logoUrl = logoSrc
  ? logoSrc.startsWith("/")
    ? `${base}${logoSrc.replace(/^\//, "")}`
    : logoSrc
  : `${base}logo.svg`;

const waLink = whatsapp
  ? `https://wa.me/${whatsapp}`
  : null;

const igLink = instagram
  ? `https://instagram.com/${instagram.replace(/^@/, "")}`
  : null;
---

<header class="site-header">
  <div class="container">
    <div class="header-top">
      <div class="brand">
        <a
          href={base}
          class="brand-link"
          aria-label="Ir al inicio"
        >
          <img
            src={logoUrl}
            alt="Logo de la tienda"
            class="logo"
          />
        </a>
      </div>

      <div class="header-actions">
        {waLink && (
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-social btn-whatsapp"
          >
            WhatsApp
          </a>
        )}

        {igLink && (
          <a
            href={igLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-social"
          >
            Instagram
          </a>
        )}
      </div>
    </div>

    <Menu />
  </div>
</header>