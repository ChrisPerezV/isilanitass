---
import Menu from "./Menu.astro";

const {
  logoSrc,
  title = "Isilanitass",
  whatsapp = "",
  instagram = "",
} = Astro.props;

const base = import.meta.env.BASE_URL;

const logoUrl = logoSrc
  ? logoSrc.startsWith("/")
    ? `${base}${logoSrc.replace(/^\//, "")}`
    : logoSrc
  : `${base}img/logo.svg`;

const waLink = whatsapp ? `https://wa.me/${whatsapp}` : "#";

const igLink = instagram
  ? `https://instagram.com/${instagram.replace(/^@/, "")}`
  : "#";
---

<header class="site-header">
  <div class="container">
    <div class="header-top">
      <div class="brand">
        <a
          href={base}
          class="brand-link"
          aria-label="Ir al inicio de Isilanitass"
        >
          <img
            src={logoUrl}
            alt={`Logo de ${title}`}
            class="logo"
          />
        </a>

        <a
          href={base}
          class="site-title"
          aria-label="Ir al inicio de Isilanitass"
        >
          {title}
        </a>
      </div>

      <div class="header-actions">
        {whatsapp && (
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-social btn-whatsapp"
          >
            WhatsApp
          </a>
        )}

        {instagram && (
          <a
            href={igLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-social"
          >
            Instagram
          </a>
        )}
      </div>
    </div>

    <Menu />
  </div>
</header>