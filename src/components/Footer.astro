---
const { whatsapp = "", instagram = "" } = Astro.props;

const waLink = whatsapp
  ? `https://wa.me/${whatsapp}`
  : null;

const igLink = instagram
  ? `https://instagram.com/${instagram.replace(/^@/, "")}`
  : null;
---

<footer class="site-footer">
  <div class="container">
    <p>
      ¿Te interesa algún producto? Escríbeme por WhatsApp o sígueme en Instagram.
    </p>

    {(waLink || igLink) && (
      <p class="footer-links">
        {waLink && (
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        )}

        {waLink && igLink && <span aria-hidden="true"> • </span>}

        {igLink && (
          <a
            href={igLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )}
      </p>
    )}
  </div>
</footer>