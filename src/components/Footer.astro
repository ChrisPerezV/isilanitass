---
const { whatsapp = "", instagram = "" } = Astro.props;

const waLink = whatsapp ? `https://wa.me/${whatsapp}` : "#";
const igLink = instagram
  ? `https://instagram.com/${instagram.replace(/^@/, "")}`
  : "#";
---

<footer class="site-footer">
  <div class="container">
    <p>
      ¿Te interesa algún producto? Escríbeme por WhatsApp o sígueme en Instagram.
    </p>
    <p>
      <a href={waLink} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      {whatsapp && instagram && " • "}
      <a href={igLink} target="_blank" rel="noopener noreferrer">Instagram</a>
    </p>
  </div>
</footer>