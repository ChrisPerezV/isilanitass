---
const base = import.meta.env.BASE_URL;

const items = [
  { href: base, label: "Inicio" },
  { href: `${base}amigurumis`, label: "Amigurumis" },
  { href: `${base}acrilicos`, label: "Figuras de acrílico" },
  { href: `${base}presentacion`, label: "Presentación" },
];
---

<nav class="menu navbar">
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>